axes.titlesize : 24
axes.labelsize : 7
lines.linewidth : 1
lines.markersize : 7
xtick.labelsize : 7
ytick.labelsize : 7
font.family :  Futura
font.size : 7
font.monospace : Futura
axes.linewidth : 1


xtick.top:           True   # draw ticks on the top side
xtick.bottom:        True    # draw ticks on the bottom side
xtick.major.size:    5     # major tick size in points
xtick.minor.size:    3       # minor tick size in points
xtick.major.width:   1.0     # major tick width in points
xtick.minor.width:   0.7    # minor tick width in points
xtick.minor.visible: True   # visibility of minor ticks on x-axis
xtick.direction : in


ytick.left:          True    # draw ticks on the left side
ytick.right:         True   # draw ticks on the right side
ytick.minor.visible: True  # visibility of minor ticks on y-axis
ytick.major.size:    5     # major tick size in points
ytick.minor.size:    3       # minor tick size in points
ytick.major.width:   1.0     # major tick width in points
ytick.minor.width:   0.7    # minor tick width in points
ytick.direction : in