axes.titlesize : 24
axes.labelsize : 20
lines.linewidth : 3
lines.markersize : 10
xtick.labelsize : 16
ytick.labelsize : 16
font.family :  Futura
font.size : 14
font.monospace : Futura
axes.linewidth : 1.6


xtick.top:           True   # draw ticks on the top side
xtick.bottom:        True    # draw ticks on the bottom side
xtick.major.size:    10     # major tick size in points
xtick.minor.size:    6       # minor tick size in points
xtick.major.width:   2.4     # major tick width in points
xtick.minor.width:   1.8    # minor tick width in points
xtick.minor.visible: True   # visibility of minor ticks on x-axis
xtick.direction : in


ytick.left:          True    # draw ticks on the left side
ytick.right:         True   # draw ticks on the right side
ytick.minor.visible: True  # visibility of minor ticks on y-axis
ytick.major.size:    10     # major tick size in points
ytick.minor.size:    6       # minor tick size in points
ytick.major.width:   2.4     # major tick width in points
ytick.minor.width:   1.8    # minor tick width in points
ytick.direction : in